# ---------------------------------------------------------------------------
# Empathetic AI — environment variables
# Copy to .env.local for local development. On Vercel, add these in
# Project Settings → Environment Variables. NEVER commit real values.
# ---------------------------------------------------------------------------

# --- Supabase (required) -----------------------------------------------------
# Project Settings → API (or "API Keys") in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# The publishable key (sb_publishable_...) or the legacy "anon" key. Safe for the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# The secret key (sb_secret_...) or legacy "service_role" key. SERVER ONLY.
# Only used for "Delete my account". Without it, deletion shows "not configured".
SUPABASE_SECRET_KEY=

# --- Language model (optional; without it the app runs in labelled demo mode) ---
# Any OpenAI-compatible endpoint works. Default: Groq (free tier available).
GROQ_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
LLM_FAST_MODEL=openai/gpt-oss-20b
LLM_FALLBACK_MODEL=llama-3.3-70b-versatile

# --- Speech-to-text (optional; uses GROQ_API_KEY by default) -----------------
TRANSCRIPTION_MODEL=whisper-large-v3-turbo
# TRANSCRIPTION_BASE_URL=https://api.groq.com/openai/v1
# TRANSCRIPTION_API_KEY=

# --- Transformer emotion model (optional) ------------------------------------
# Hugging Face access token (read). Enables DistilRoBERTa in the emotion fusion.
HF_TOKEN=
HF_EMOTION_MODEL=j-hartmann/emotion-english-distilroberta-base

# --- Abuse protection for a public demo --------------------------------------
RATE_LIMIT_PER_HOUR=40
RATE_LIMIT_PER_DAY=200
